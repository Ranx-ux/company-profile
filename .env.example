#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Ganti app.baseURL ke URL hosting Anda.
# Jika aplikasi berada langsung di root domain, gunakan '/' di akhir.
app.baseURL = 'https://companyprofil.tokodusaudaratani.my.id/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.appTimezone = 'Asia/Jakarta'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Ganti nilai di bawah ini sesuai database hosting Anda.
database.default.hostname = localhost
database.default.database = gres3793_company123
database.default.username = gres3793_company123
database.default.password = rangga483
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'ci_session'
session.expiration = 7200
session.savePath = 'writable/session'
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenRandomize = false
security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = false
security.samesite = 'Lax'

#--------------------------------------------------------------------
# GOOGLE OAUTH
#--------------------------------------------------------------------
# Konfigurasi Google OAuth Login
# Client ID dari Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id
# Client Secret dari Google Cloud Console (isi sendiri)
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Callback URL setelah login Google
GOOGLE_CALLBACK_URL=https://companyprofil.tokodusaudaratani.my.id/auth/callback

#--------------------------------------------------------------------
# MIDTRANS PAYMENT GATEWAY
#--------------------------------------------------------------------
# Konfigurasi Midtrans Snap
# Merchant ID dari Midtrans Dashboard
MIDTRANS_MERCHANT_ID=M311702612
# Client Key dari Midtrans Dashboard
MIDTRANS_CLIENT_KEY=Mid-client-z1UxHuyo-gskwJCG
# Server Key dari Midtrans Dashboard
MIDTRANS_SERVER_KEY=your_midtrans_server_key
# true = Production, false = Sandbox
MIDTRANS_IS_PRODUCTION=false

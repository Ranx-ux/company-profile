# Rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Send root requests directly to public/index.php
    RewriteRule ^$ public/index.php [L]

    # Send all other requests to public/ directory unless already in public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
